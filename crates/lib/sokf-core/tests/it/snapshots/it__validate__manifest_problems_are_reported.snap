{
  "errors": [
    {
      "path": "/knowledge/manifest.sokf.yaml",
      "message": "the manifest declares no `scope`. The scope names the store's owner as a slug: lower-case letters and digits joined by single hyphens. The store's identity is `<scope>/<name>` (SOKF_FORMAT_10)"
    },
    {
      "path": "/knowledge/manifest.sokf.yaml",
      "line": 1,
      "message": "the manifest declares sokf `0.5`. This tool implements `0.7`. Version 0.7 changes the schemas: each `max` is a map with its `when-at-limit`, and sokf supplies no line format. Fix the findings on the store's schemas, and then declare `sokf: \"0.7\"`. The changelog lists every change: https://github.com/six5536/sokf/blob/main/sokf-spec/changelog.md#07 (SOKF_VALIDATION_3)"
    },
    {
      "path": "/knowledge/manifest.sokf.yaml",
      "line": 2,
      "message": "the manifest declares no `name` (SOKF_FORMAT_10)"
    },
    {
      "path": "/knowledge/manifest.sokf.yaml",
      "line": 3,
      "message": "the manifest contains `generated`, a key that sokf adds only when it publishes the store. The key must not appear in the working tree (SOKF_FORMAT_16)"
    }
  ],
